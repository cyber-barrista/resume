{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "paths": {
      "src/*": ["./src/*"]
    },
    "types": ["node", "vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
